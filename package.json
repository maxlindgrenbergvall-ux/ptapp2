{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "bash scripts/test-db.sh",
    "typecheck": "tsc --noEmit",
    "mobile:www": "node scripts/mobile-www.mjs",
    "cap:sync": "npm run mobile:www && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "mobile:icons": "node scripts/mobile-icons.mjs",
    "mobile:assets": "capacitor-assets generate --assetPath mobile/assets --iconBackgroundColor '#aced37' --iconBackgroundColorDark '#aced37' --splashBackgroundColor '#aced37' --splashBackgroundColorDark '#0b0f0d' --ios --android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@revenuecat/purchases-capacitor": "13.7.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "13.5.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
