# --- Supabase (Project Settings → API). Utan dessa körs appen i demoläge. ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Endast server (aldrig NEXT_PUBLIC_). Krävs för wearables (spara tokens, synk, webhooks). ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Fitbit (dev.fitbit.com, app-typ "Server", scope "sleep"). Tomt = mock-enhet. ---
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
# Verifieringskod för Fitbit Subscriptions (webhook /api/wearables/fitbit/webhook).
FITBIT_SUBSCRIBER_VERIFY=

# --- Samtal: STUN/TURN-servrar som JSON. Tomt = Googles publika STUN (räcker för de flesta nät). ---
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# --- Livsmedel: Open Food Facts (öppen produktdatabas, ingen nyckel krävs). ---
# Kontaktuppgift i User-Agent enligt OFF:s riktlinjer (e-post eller URL).
OPENFOODFACTS_CONTACT=
# Endast för test mot mock (e2e/mock-openfoodfacts.mjs).
# OPENFOODFACTS_BASE_URL=http://localhost:54400
